3d\u043e\u0432\u044b\u043c\u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430\u043c\u0438!</p>"},{"location":"#_2","title":"\u2728 \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438","text":"\ud83c\udfdd\ufe0f \u041b\u0435\u0442\u0430\u044e\u0449\u0438\u0435 \u043e\u0441\u0442\u0440\u043e\u0432\u0430\u2708\ufe0f \u0410\u044d\u0440\u043e\u043d\u0430\u0432\u0442\u0438\u043a\u0430\u2699\ufe0f \u0422\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438\ud83c\udfae \u041f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f <p>\u041c\u0438\u0440 \u0441\u043e\u0441\u0442\u043e\u0438\u0442 \u0438\u0437 \u043f\u0430\u0440\u044f\u0449\u0438\u0445 \u0432 \u043d\u0435\u0431\u0435 \u043e\u0441\u0442\u0440\u043e\u0432\u043e\u0432 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u0431\u0438\u043e\u043c\u043e\u0432. \u0418\u0441\u0441\u043b\u0435\u0434\u0443\u0439\u0442\u0435 \u0438\u0445 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0432\u043e\u0437\u0434\u0443\u0448\u043d\u044b\u0445 \u043a\u043e\u0440\u0430\u0431\u043b\u0435\u0439 \u0438 \u0434\u0438\u0440\u0438\u0436\u0430\u0431\u043b\u0435\u0439!</p> <p>\u0421\u0442\u0440\u043e\u0439\u0442\u0435 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u043b\u0435\u0442\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u044b: \u043e\u0442 \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0432\u043e\u0437\u0434\u0443\u0448\u043d\u044b\u0445 \u0448\u0430\u0440\u043e\u0432 \u0434\u043e \u043c\u043e\u0449\u043d\u044b\u0445 \u0434\u0438\u0440\u0438\u0436\u0430\u0431\u043b\u0435\u0439 \u0438 \u043f\u043b\u0430\u043d\u0435\u0440\u043e\u0432!</p> <p>\u0420\u0430\u0437\u0432\u0438\u0432\u0430\u0439\u0442\u0435 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438, \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u044b \u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u0443\u0439\u0442\u0435 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u044b \u043d\u0430 \u0441\u0432\u043e\u0438\u0445 \u043e\u0441\u0442\u0440\u043e\u0432\u0430\u0445.</p> <p>\u0423\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u043a\u0432\u0435\u0441\u0442\u044b, \u0434\u0430\u043d\u0436\u0438 \u0432 \u043d\u0435\u0431\u0435 \u0438 \u043e\u043f\u0430\u0441\u043d\u044b\u0435 \u043c\u043e\u0431\u044b \u0436\u0434\u0443\u0442 \u0441\u043c\u0435\u043b\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439!</p>"},{"location":"#_3","title":"\ud83d\udce6 \u0427\u0442\u043e \u0432\u043d\u0443\u0442\u0440\u0438?","text":"<p>\u041c\u043e\u0434\u043f\u0430\u043a \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0431\u043e\u043b\u0435\u0435 100 \u043c\u043e\u0434\u043e\u0432, \u0442\u0449\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0445 \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0438\u0433\u0440\u043e\u0432\u043e\u0433\u043e \u043e\u043f\u044b\u0442\u0430:</p> \u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u041f\u0440\u0438\u043c\u0435\u0440\u044b \u043c\u043e\u0434\u043e\u0432 \u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u041e\u0441\u043d\u043e\u0432\u0430 Aeronautics, VS Clockwork \u041b\u0435\u0442\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u044b \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u044b \u0413\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f \u043c\u0438\u0440\u0430 Sky Islands, Terralith \u041b\u0435\u0442\u0430\u044e\u0449\u0438\u0435 \u043e\u0441\u0442\u0440\u043e\u0432\u0430 \u0438 \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0435 \u0431\u0438\u043e\u043c\u044b \u0422\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438 Create, Immersive Engineering \u041c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u044b \u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f \u041c\u0430\u0433\u0438\u044f Botania, Ars Nouveau \u041c\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0438 \u0430\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u044b \u0414\u0435\u043a\u043e\u0440 Chipped, Macaw's \u0422\u044b\u0441\u044f\u0447\u0438 \u0431\u043b\u043e\u043a\u043e\u0432 \u0434\u043b\u044f \u043f\u043e\u0441\u0442\u0440\u043e\u0439\u043a\u0438 <p>\u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043f\u043e\u043b\u043d\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a \u2192</p>"},{"location":"#_4","title":"\ud83d\ude80 \u0411\u044b\u0441\u0442\u0440\u044b\u0439 \u0441\u0442\u0430\u0440\u0442","text":"<p>3 \u0448\u0430\u0433\u0430 \u0434\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u0438\u0433\u0440\u044b</p> <p>\u0428\u0430\u0433 1: \u0421\u043a\u0430\u0447\u0430\u0439\u0442\u0435 \u043c\u043e\u0434\u043f\u0430\u043a \u0441 Modrinth</p> <p>\u0428\u0430\u0433 2: \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u0447\u0435\u0440\u0435\u0437 \u0432\u0430\u0448 \u043b\u044e\u0431\u0438\u043c\u044b\u0439 \u043b\u0430\u0443\u043d\u0447\u0435\u0440 (Prism, ATLauncher, CurseForge)</p> <p>\u0428\u0430\u0433 3: \u0417\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u0438\u0433\u0440\u0443 \u0438 \u043d\u0430\u0447\u043d\u0438\u0442\u0435 \u0441\u0432\u043e\u0451 \u043d\u0435\u0431\u0435\u0441\u043d\u043e\u0435 \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435!</p> <p>\u041f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f: \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u043c\u043e\u0434\u043f\u0430\u043a\u0430 \u2192</p>"},{"location":"#_5","title":"\ud83c\udfaf \u0414\u043b\u044f \u043a\u043e\u0433\u043e \u044d\u0442\u043e\u0442 \u043c\u043e\