40\u0430\u0437\u0434\u0435\u043b\u044b","text":""},{"location":"#_4","title":"\u041c\u043e\u0434\u044b","text":"<p>\u0421\u043f\u0438\u0441\u043e\u043a \u0438 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0432\u0441\u0435\u0445 \u043c\u043e\u0434\u043e\u0432 \u0432 \u0441\u0431\u043e\u0440\u043a\u0435, \u0432\u043a\u043b\u044e\u0447\u0430\u044f Aeronautics \u0438 \u043a\u0430\u0441\u0442\u043e\u043c\u043d\u044b\u0435 \u043c\u043e\u0434\u044b.</p>"},{"location":"#_5","title":"\u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0438","text":"<p>\u0418\u0433\u0440\u043e\u0432\u044b\u0435 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438: \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044f \u0441 EVE Online, \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0430, \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u043e\u0440\u0430\u0431\u043b\u0438, \u0434\u043e\u0431\u044b\u0447\u0430 \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432.</p>"},{"location":"#_6","title":"\u0420\u0435\u0446\u0435\u043f\u0442\u044b","text":"<p>\u0411\u0430\u0437\u043e\u0432\u044b\u0435 \u0438 \u043f\u0440\u043e\u0434\u0432\u0438\u043d\u0443\u0442\u044b\u0435 \u0440\u0435\u0446\u0435\u043f\u0442\u044b \u043a\u0440\u0430\u0444\u0442\u0430, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043a\u043e\u0440\u0430\u0431\u043b\u0438 \u0438 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u044b.</p>"},{"location":"#_7","title":"\u0420\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430","text":"<p>\u0420\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u0430 \u0434\u043b\u044f \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432 \u043a\u043e\u043c\u0430\u043d\u0434\u044b: \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043c\u043e\u0434\u043e\u0432, \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0440\u0435\u0446\u0435\u043f\u0442\u043e\u0432, \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435.</p>"},{"location":"#_8","title":"\ud83d\udd27 \u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b","text":"<p>\u041c\u043e\u0434\u043f\u0430\u043a \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442: - Packwiz \u2014 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043c\u043e\u0434\u0430\u043c\u0438 \u0447\u0435\u0440\u0435\u0437 Git - GitHub Actions \u2014 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0441\u0431\u043e\u0440\u043a\u0430 - MkDocs \u2014 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u044f</p>"},{"location":"#_9","title":"\ud83d\udc65 \u041a\u043e\u043c\u0430\u043d\u0434\u0430","text":"<p>\u0414\u043e 5 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u043d\u0430\u0434 \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u043c. \u042d\u0442\u043e \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u044f\u044f \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u044f \u0434\u043b\u044f \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432.</p>"}]}